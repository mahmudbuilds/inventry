# Inventry Backend Environment Variables Example
DEBUG=True
SECRET_KEY=replace-with-a-secure-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: PostgreSQL Database connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/inventry_db

# Optional: Comma-separated list of trusted CSRF origins
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
